{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/saltyma/ioc-evidence-packager/schemas/canonical-event-v1.schema.json",
  "title": "IOC Evidence Packager canonical event v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "event_id", "source", "time", "event", "observables", "adapter"],
  "properties": {
    "schema": {
      "const": "canonical-event/1.0.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_id", "position"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "position": {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": {"enum": ["line", "record", "offset"]},
            "value": {"type": ["integer", "string"]}
          }
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": true,
      "required": ["original"],
      "properties": {
        "original": {"type": "string"},
        "utc": {"type": ["string", "null"], "format": "date-time"},
        "precision": {"type": ["string", "null"]},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": true,
      "required": ["category", "action"],
      "properties": {
        "category": {"type": "string"},
        "action": {"type": "string"}
      }
    },
    "observables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "field_path", "original", "canonical"],
        "properties": {
          "kind": {"enum": ["ipv4", "ipv6", "domain", "url", "md5", "sha1", "sha256"]},
          "field_path": {"type": "string", "minLength": 1},
          "original": {"type": "string"},
          "canonical": {"type": "string"}
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
